{
  "manifest_version": 3,
  "name": "إكزامكس — رصد الدرجات في نظام نور",
  "version": "1.0.0",
  "description": "استيراد ورصد درجات اختبارات إكزامكس (من ملف Excel المصدّر أو نسخ لنور) تلقائياً في صفحة رصد الدرجات بنظام نور.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://noor.moe.gov.sa/Noor/EduWaveEducational/DegreesEducationalPathSystem.aspx*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
